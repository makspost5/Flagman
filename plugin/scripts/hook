#!/usr/bin/env bash
# Hook launcher. Usage: hook post-tool | prompt (JSON on stdin).
# Safe to source (". hook post-tool") or to run (bash hook post-tool); bash only.
# Always ends with exit 0 (or the Python exit code); never prints errors.
#
# Only a bounded prefix of stdin is read here. `read` takes one byte per syscall,
# and PostToolUse input can be megabytes (Edit's originalFile, Write's content).
# "session_id" and, normally, "file_path" come first. Bash 3.2 has -n but not -N.
case "$1" in
    post-tool) _fm_max=8192 ;;
    prompt) _fm_max=2048 ;;
    *) exit 0 ;;
esac
IFS= read -r -d '' -n "$_fm_max" _fm_input || true
_fm_full=0
[ "${#_fm_input}" -ge "$_fm_max" ] && _fm_full=1
case "$1" in
    post-tool)
        # watch_files setting (CLAUDE_PLUGIN_OPTION_WATCH_FILES): comma-separated file
        # names or globs, matched against the file name without case; nothing set means
        # status.md,plan.md. hook.py applies the same rule.
        _fm_re='"file_path"[[:space:]]*:[[:space:]]*"([^"]*)"'
        # auto_graph setting (CLAUDE_PLUGIN_OPTION_AUTO_GRAPH): off, ask or on; anything
        # else is ask. Unless off, plan files and the todo tools go to Python too
        # (taskgraph/autograph.py has the same rule).
        _fm_auto=1
        _fm_a="${CLAUDE_PLUGIN_OPTION_AUTO_GRAPH:-}"
        _fm_a="${_fm_a//[[:space:]]/}"
        case "$_fm_a" in [Oo][Ff][Ff]) _fm_auto=0 ;; esac
        case "$_fm_input" in
            *'"file_path"'*)
                if [[ $_fm_input =~ $_fm_re ]]; then
                    _fm_name="${BASH_REMATCH[1]##*[/\\]}"
                    _fm_pats=()
                    IFS=, read -r -a _fm_raw <<< "${CLAUDE_PLUGIN_OPTION_WATCH_FILES:-}"
                    for _fm_p in "${_fm_raw[@]}"; do
                        _fm_p="${_fm_p#"${_fm_p%%[! ]*}"}"
                        _fm_p="${_fm_p%"${_fm_p##*[! ]}"}"
                        case "$_fm_p" in ''|'${user_config.'*) ;; *) _fm_pats+=("$_fm_p") ;; esac
                    done
                    [ "${#_fm_pats[@]}" -gt 0 ] || _fm_pats=(status.md plan.md)
                    _fm_hit=0
                    # a JSON escape in the name: let Python decide
                    case "$_fm_name" in *'\u'*) _fm_hit=1 ;; esac
                    _fm_nc=$(shopt -p nocasematch)
                    shopt -s nocasematch
                    for _fm_p in "${_fm_pats[@]}"; do
                        # shellcheck disable=SC2254
                        case "$_fm_name" in $_fm_p) _fm_hit=1; break ;; esac
                    done
                    # a plan: *.md with "plan" in the name or in a plans/ folder
                    if [ "$_fm_hit" = 0 ] && [ "$_fm_auto" = 1 ]; then
                        case "$_fm_name" in
                            *plan*.md) _fm_hit=1 ;;
                            *.md) case "${BASH_REMATCH[1]}" in *[/\\]plans[/\\]*) _fm_hit=1 ;; esac ;;
                        esac
                    fi
                    eval "$_fm_nc"
                    if [ "$_fm_hit" = 0 ]; then
                        [ "$_fm_full" = 1 ] && cat >/dev/null 2>&1
                        exit 0
                    fi
                elif [ "$_fm_full" = 0 ]; then
                    exit 0
                fi
                ;;
            *'"tool_name"'*'"TodoWrite"'*|*'"tool_name"'*'"TaskCreate"'*)
                [ "$_fm_auto" = 1 ] || { [ "$_fm_full" = 1 ] && cat >/dev/null 2>&1; exit 0; }
                ;;
            *)
                # the path may follow a long old_string/content: let Python decide
                [ "$_fm_full" = 1 ] || exit 0
                ;;
        esac
        _fm_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        # probe in a subshell: pick-python.sh may call exit
        _fm_py=$( source "$_fm_here/pick-python.sh" 2>/dev/null; printf '%s' "${PY[*]}" )
        read -r -a _fm_pya <<< "$_fm_py"
        if [ "${#_fm_pya[@]}" -eq 0 ]; then
            [ "$_fm_full" = 1 ] && cat >/dev/null 2>&1
            exit 0
        fi
        { printf '%s' "$_fm_input"; cat; } | "${_fm_pya[@]}" "$_fm_here/hook.py" post-tool
        exit 0
        ;;
    prompt)
        _fm_re='"session_id"[[:space:]]*:[[:space:]]*"([^"]*)"'
        _fm_sid=none
        if [[ $_fm_input =~ $_fm_re ]] && [ -n "${BASH_REMATCH[1]}" ]; then
            _fm_sid="${BASH_REMATCH[1]//[^A-Za-z0-9_.-]/_}"
            _fm_sid="${_fm_sid:0:80}"
        fi
        [ "$_fm_full" = 1 ] && cat >/dev/null 2>&1
        _fm_dir="${CLAUDE_PLUGIN_DATA:-$HOME/.flagman}"
        _fm_m=("$_fm_dir"/reminded-"$_fm_sid"-*)
        [ -e "${_fm_m[0]}" ] && rm -f "${_fm_m[@]}" 2>/dev/null
        exit 0
        ;;
esac
exit 0
